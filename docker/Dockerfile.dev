# syntax=docker/dockerfile:1
#
# UNTESTED: this file was written on a machine without a Docker daemon. It has
# never been built. The base image tags were checked against the official
# image manifests (github.com/docker-library/official-images, 2026-10); the
# COPY --from paths are the ones those images document. Expect to fix details
# on the first `docker build`. See docs/BUILD.md, "Docker".
#
# One image with every toolchain SmartDelegate can use, and the repository:
#   Python (the reference), JDK 21, Node 22, Go, PHP 8.4 (sodium, openssl,
#   mbstring), Rust + a C compiler, PostgreSQL (for the live upstream suite).
#
#   docker build -f docker/Dockerfile.dev -t smartdelegate-dev:0.3.0 .        (context: the repository root)
#   docker run --rm smartdelegate-dev:0.3.0                                   runs ./bootstrap.sh --full
#   docker run --rm --privileged smartdelegate-dev:0.3.0                      the same, and the boundary test
#                                                                             can create its network namespace
#   docker run --rm -it smartdelegate-dev:0.3.0 bash
#
# Versions: the code was developed with Go 1.24, Rust 1.95, Node 22, PHP 8.4
# and JDK 21 on the host. The tags below are the ones the official images
# list today; Go and Rust are therefore newer here than what was run natively.

FROM node:22-bookworm-slim AS node
FROM golang:1.26-bookworm AS go
FROM eclipse-temurin:21-jdk-jammy AS jdk
FROM rust:1.99-slim-bookworm AS rust

# The PHP image is the base because PHP is the toolchain with the most shared
# library dependencies (libsodium, libssl, oniguruma ...); the others are
# self-contained directories that can be copied in. It is Debian bookworm and
# keeps gcc, g++, make and libc headers (PHPIZE_DEPS): the C compiler for the
# Rust port's linker and its C ABI check.
FROM php:8.4-cli-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip \
      ca-certificates curl git make procps iproute2 util-linux \
      postgresql postgresql-client \
 && rm -rf /var/lib/apt/lists/*

# Node.js and npm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Go
COPY --from=go /usr/local/go /usr/local/go

# JDK (Temurin is built for Ubuntu 22.04's glibc 2.35; bookworm has 2.36)
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk

# Rust (rustup's toolchain directory and cargo)
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo

ENV JAVA_HOME=/opt/java/openjdk \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    GOTOOLCHAIN=local \
    GOFLAGS=-buildvcs=false \
    PATH=/opt/java/openjdk/bin:/usr/local/cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Fail the build here, with the doctor's table, if a toolchain did not arrive.
WORKDIR /src/smartdelegate
COPY scripts/doctor.py scripts/doctor.py
RUN python3 scripts/doctor.py --require python,venv,java,node,npm,go,php,rust,cc,postgres

COPY . .

# Build everything once (the Rust port downloads its crates here), so that a
# container starts with built ports. Skipped parts are failures in this image.
RUN ./bootstrap.sh --no-verify --require java,node,js,go,php,rust

CMD ["./bootstrap.sh", "--full"]
