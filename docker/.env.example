# Template for docker/.env, read by `docker compose --env-file docker/.env`
# (make docker-test uses it when it exists). Copy it and fill in every value:
#
#   cp docker/.env.example docker/.env        (docker/.env is git-ignored)
#
# There are NO real secrets in this file and none may be committed. Generate
# each value yourself, for example:
#
#   python3 -c "import secrets; print(secrets.token_hex(20))"
#
# Without a docker/.env, `make docker-test` invents throwaway values for one
# run and keeps them in memory only.

# API keys of the SmartDelegate daemon (16+ characters each).
SD_ADMIN_KEY=
SD_PEP_KEY=

# The key of the upstream company API. Only the http-proxy and company-api
# containers get it; the agent container never does.
SD_UPSTREAM_KEY=

# Keycloak's bootstrap administrator (dev mode).
SD_KEYCLOAK_ADMIN=admin
SD_KEYCLOAK_ADMIN_PASSWORD=

# PostgreSQL superuser password of the test database.
POSTGRES_PASSWORD=

# Optional. Where the services' ports are published on the host, so that the
# live suites can also be run natively against these containers (docs/BUILD.md).
# SD_PUBLISH_HOST=127.0.0.1
# Optional. The Keycloak image tag (live/idp/keycloak.sh uses the same version by default).
# SD_KEYCLOAK_VERSION=26.0.7
