{
 "about": "HR and IT operations: who sees which employee fields, access requests, break-glass.",
 "cases": [
  {
   "name": "HR sees the national id and the emergency contact, never the bank account",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "maya",
       "agents": [
        "hr-orchestrator"
       ],
       "role": "hr-partner",
       "task": "onboard-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.employee",
       "id": "emp-1"
      },
      "data": {
       "id": "emp-1",
       "name": "New Hire",
       "email": "new.hire@kestrel.example",
       "unit": "sales",
       "region": "EU",
       "manager": "sofia",
       "job_title": "Account executive",
       "start_date": "2026-11-01",
       "status": "pending",
       "national_id": "AB123456",
       "home_address": "1 Main St",
       "bank_account": "DE02120300000000202051",
       "emergency_contact": "partner, +49 30 000"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "bank_account"
      ]
     }
    }
   ]
  },
  {
   "name": "an HR partner has no access to salaries; an HR manager has",
   "steps": [
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "maya",
       "agents": [
        "hr-orchestrator"
       ],
       "role": "hr-partner",
       "task": "onboard-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.salary",
       "id": "emp-1"
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "no_matching_permit"
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "oskar",
       "agents": [
        "hr-orchestrator"
       ],
       "role": "hr-manager",
       "task": "salary-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.salary",
       "id": "emp-1"
      },
      "data": {
       "employee_id": "emp-1",
       "base": 520000,
       "notes": "x"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": []
     }
    }
   ]
  },
  {
   "name": "IT sees the basic employee fields only",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "yara",
       "agents": [
        "it-orchestrator"
       ],
       "role": "it-operator",
       "task": "onboard-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.employee",
       "id": "emp-1"
      },
      "data": {
       "id": "emp-1",
       "name": "New Hire",
       "email": "new.hire@kestrel.example",
       "unit": "sales",
       "region": "EU",
       "manager": "sofia",
       "job_title": "Account executive",
       "start_date": "2026-11-01",
       "status": "pending",
       "national_id": "AB123456",
       "home_address": "1 Main St",
       "bank_account": "DE02120300000000202051",
       "emergency_contact": "partner, +49 30 000"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "bank_account",
       "emergency_contact",
       "home_address",
       "national_id"
      ]
     }
    }
   ]
  },
  {
   "name": "IT has no access to salaries or reviews",
