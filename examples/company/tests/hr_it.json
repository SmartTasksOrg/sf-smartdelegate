     "input": {
      "chain": {
       "user": "yara",
       "agents": [
        "it-orchestrator"
       ],
       "role": "it-operator",
       "task": "onboard-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.salary",
       "id": "emp-1"
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "no_matching_permit"
     }
    },
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "yara",
       "agents": [
        "it-orchestrator"
       ],
       "role": "it-operator",
       "task": "onboard-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.review",
       "id": "emp-1"
