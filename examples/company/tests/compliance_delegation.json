  {
   "name": "the auditor changes nothing",
   "steps": [
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "update",
      "resource": {
       "path": "crm.customer",
       "id": "c-1",
       "attrs": {
        "region": "EU"
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "policy_forbid",
      "policies": [
       "auditor-role-is-read-only"
      ]
     }
    },
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "create",
      "resource": {
       "path": "finance.payment",
       "id": "pay-1",
       "attrs": {
        "kind": "po",
        "requested_by": "uma",
        "approved_by": "wendy"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 100
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "policy_forbid"
     }
    },
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "approve",
      "resource": {
       "path": "procurement.po",
       "id": "po-1",
       "attrs": {
        "requested_by": "uma"
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "policy_forbid"
     }
    }
   ]
