  {
   "name": "the auditor sees amounts but no card number, bank account, tax id, salary or review note",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-1"
      },
      "data": {
       "id": "c-1",
       "name": "Ada Lovelace",
       "email": "ada@example.com",
       "phone": "+44 20 7946 0000",
       "region": "EU",
       "tier": "gold",
       "notes": "prefers email",
       "addresses": [
        {
         "city": "London",
         "geo": "51.5,-0.1"
        }
       ],
       "card": {
        "last4": "4242",
        "number": "4000000000004242"
       }
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "card.number"
      ]
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "read",
      "resource": {
       "path": "procurement.vendor",
       "id": "v-1"
      },
      "data": {
       "id": "v-1",
       "name": "Acme Tooling",
       "region": "EU",
       "status": "active",
       "contact_email": "ap@acme.example",
       "tax_id": "DE123",
       "risk_score": 2,
       "bank": {
        "iban": "DE89370400440532013000",
        "bic": "COBADEFF"
       },
       "onboarded_by": "uma"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "bank.bic",
       "bank.iban",
       "tax_id"
      ]
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "read",
      "resource": {
       "path": "hr.salary",
       "id": "emp-1"
      },
      "data": {
       "employee_id": "emp-1",
       "grade": "L3",
       "base": 1,
       "bonus": 2,
       "notes": "n"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "base",
       "bonus",
       "notes"
      ],
      "data": {
       "employee_id": "emp-1",
       "grade": "L3"
      }
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "carla",
       "agents": [
        "compliance-orchestrator"
       ],
       "role": "auditor",
       "task": "audit-2026q3"
      },
      "action": "read",
      "resource": {
       "path": "finance.payment",
       "id": "pay-1"
      },
      "data": {
       "id": "pay-1",
       "amount": 100000,
       "beneficiary": {
        "name": "Acme",
        "iban": "DE89"
       }
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "beneficiary.iban"
      ],
      "data": {
       "id": "pay-1",
       "amount": 100000,
       "beneficiary": {
        "name": "Acme",
        "iban": "[REDACTED]"
       }
      }
     }
    }
   ]
  },
