  {
   "name": "a role is lent to its own agent, for its own kind of task, within its budget",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "anna",
      "agent": "finance-orchestrator",
      "role": "support-agent",
      "task": "ticket-1"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "role_exceeded"
      }
     }
    },
    {
     "op": "issue_token",
     "input": {
      "user": "anna",
      "agent": "support-orchestrator",
      "role": "support-agent",
      "task": "audit-1"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "role_exceeded"
      }
     }
    },
    {
     "op": "issue_token",
     "input": {
      "user": "anna",
      "agent": "support-orchestrator",
      "role": "support-agent",
      "task": "ticket-1",
      "cap": {
       "actions": [
        "create"
       ],
       "resources": [
        "billing.refund/*"
       ],
       "budget": {
        "EUR": 20001
       }
      }
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "role_exceeded"
      }
     }
    }
   ]
  },
