  {
   "name": "an orchestrator hands work to its own specialists, never across units, never to an unknown agent",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "petra",
      "agent": "sales-orchestrator",
      "role": "sales-rep",
      "task": "contract-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "exchange_token",
     "input": {
      "subject_token": "$t",
      "actor": "contract-summarizer"
     },
     "save": {
      "t2": "token"
     },
     "expect": {
      "ok": true,
      "chain": [
       "sales-orchestrator",
       "contract-summarizer"
      ],
      "role": "sales-rep"
     }
    },
    {
     "op": "exchange_token",
     "input": {
      "subject_token": "$t2",
      "actor": "clause-extractor"
     },
     "expect": {
      "ok": true,
      "chain": [
       "sales-orchestrator",
       "contract-summarizer",
       "clause-extractor"
      ]
     }
    },
    {
     "op": "exchange_token",
     "input": {
      "subject_token": "$t",
      "actor": "finance-orchestrator"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "delegation_denied"
      }
     }
    },
    {
     "op": "exchange_token",
     "input": {
      "subject_token": "$t",
      "actor": "rogue-bot"
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unknown_agent"
      }
     }
