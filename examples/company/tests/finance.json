  {
   "name": "payroll reads salaries but not review notes; a payroll payment waits for a finance approver",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "liam",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "payroll-officer",
       "task": "payroll-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.salary",
       "id": "emp-1"
      },
      "data": {
       "employee_id": "emp-1",
       "currency": "EUR",
       "grade": "L3",
       "base": 520000,
       "bonus": 0,
       "notes": "retention risk"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "notes"
      ]
     }
    },
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "liam",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "payroll-officer",
       "task": "payroll-1"
      },
      "action": "read",
      "resource": {
       "path": "hr.review",
       "id": "emp-1"
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "no_matching_permit"
     }
    },
    {
     "op": "issue_token",
     "input": {
      "user": "liam",
      "agent": "finance-orchestrator",
      "role": "payroll-officer",
      "task": "payroll-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "finance.payment",
       "id": "payroll-2026-09",
       "attrs": {
        "kind": "payroll"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 2000000
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "approval_required",
      "approval": {
       "label": "payroll-run"
      }
     }
    }
   ]
  },
