  {
   "name": "accounts payable does not see vendor bank details or the tax id",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "gina",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "ap-clerk",
       "task": "pay-1"
      },
      "action": "read",
      "resource": {
       "path": "procurement.vendor",
       "id": "v-1"
      },
      "data": {
       "id": "v-1",
       "name": "Acme Tooling",
       "region": "EU",
       "status": "active",
       "contact_email": "ap@acme.example",
       "tax_id": "DE123",
       "risk_score": 2,
       "bank": {
        "iban": "DE89370400440532013000",
        "bic": "COBADEFF"
       },
       "onboarded_by": "uma"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "bank.bic",
       "bank.iban",
       "tax_id"
      ]
     }
    }
   ]
  },
  {
   "name": "treasury sees vendor bank details and may change them, and nothing else",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "karin",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "treasury",
       "task": "treasury-1"
      },
      "action": "read",
      "resource": {
       "path": "procurement.vendor",
       "id": "v-1"
      },
      "data": {
       "id": "v-1",
       "name": "Acme Tooling",
       "region": "EU",
       "status": "active",
       "contact_email": "ap@acme.example",
       "tax_id": "DE123",
       "risk_score": 2,
       "bank": {
        "iban": "DE89370400440532013000",
        "bic": "COBADEFF"
       },
       "onboarded_by": "uma"
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [],
      "data": {
       "bank": {
        "iban": "DE89370400440532013000",
        "bic": "COBADEFF"
       }
      }
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "karin",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "treasury",
       "task": "treasury-1"
      },
      "action": "update",
      "resource": {
       "path": "procurement.vendor",
       "id": "v-1"
      },
      "data": {
       "bank": {
        "iban": "DE00",
        "bic": "X"
       }
      },
      "strict": true
     },
     "expect": {
      "effect": "allow"
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "karin",
       "agents": [
        "finance-orchestrator"
       ],
       "role": "treasury",
       "task": "treasury-1"
      },
      "action": "update",
      "resource": {
       "path": "procurement.vendor",
       "id": "v-1"
      },
      "data": {
       "name": "Other"
      },
      "strict": true
     },
     "expect": {
      "effect": "deny",
      "reason": "field_denied"
     }
    }
   ]
  },
