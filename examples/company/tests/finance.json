{
 "about": "Finance: payments, separation of duties, bank details, the ledger, payroll.",
 "cases": [
  {
   "name": "accounts payable pays an approved purchase order of 1,000.00 without further approval",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "gina",
      "agent": "finance-orchestrator",
      "role": "ap-clerk",
      "task": "pay-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "finance.payment",
       "id": "pay-1",
       "attrs": {
        "kind": "po",
        "requested_by": "uma",
        "approved_by": "wendy"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 100000
       }
      }
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "ap-pay-small"
      ]
     }
    }
   ]
  },
  {
   "name": "above 1,000.00 a finance approver must release the payment",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "gina",
      "agent": "finance-orchestrator",
      "role": "ap-clerk",
      "task": "pay-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "finance.payment",
       "id": "pay-2",
       "attrs": {
        "kind": "po",
        "requested_by": "uma",
        "approved_by": "wendy"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 100001
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "approval_required",
      "approval": {
       "label": "payment-over-1000"
      }
     }
    }
   ]
  },
