  {
   "name": "nobody refunds their own customer account",
   "steps": [
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "rf-4",
       "attrs": {
        "region": "EU",
