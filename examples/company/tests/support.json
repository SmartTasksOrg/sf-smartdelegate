  {
   "name": "a list of refunds: rows of other regions, and rows that state no region, are dropped whatever region the request states",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "billing.refund",
       "id": "list",
       "attrs": {
        "region": "EU"
       }
      },
      "data": [
       {
        "id": "rf-1",
        "region": "EU",
        "currency": "EUR"
       },
       {
        "id": "rf-2",
        "region": "US",
        "currency": "USD"
       },
       {
        "id": "rf-3",
        "currency": "EUR"
       },
       {
        "id": "rf-4",
        "region": "EU",
        "currency": "EUR"
       }
      ]
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "support-read-refund"
      ],
      "rows_dropped": 2,
      "data": [
       {
        "id": "rf-1",
        "region": "EU",
        "currency": "EUR"
       },
       {
        "id": "rf-4",
        "region": "EU",
        "currency": "EUR"
       }
      ],
      "obligations": {
       "row_filter": [
        {
         "column": "region",
         "op": "eq",
         "value": "EU"
        }
       ]
      }
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "billing.refund",
       "id": "rf-2",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "id": "rf-2",
       "region": "US",
       "currency": "USD"
      }
     },
     "expect": {
      "effect": "allow",
      "data": null,
      "rows_dropped": 1
     }
    }
   ]
  }
