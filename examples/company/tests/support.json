{
 "about": "Support: region, refunds, field views. Tests run without tokens (`chain` states who is acting), so they exercise the policies and the catalog, not the role ceilings.",
 "cases": [
  {
   "name": "a support agent's orchestrator reads a customer of its own region; card number redacted, secret-free",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-1",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "id": "c-1",
       "name": "Ada Lovelace",
       "email": "ada@example.com",
       "phone": "+44 20 7946 0000",
       "region": "EU",
       "tier": "gold",
       "notes": "prefers email",
       "addresses": [
        {
         "city": "London",
         "geo": "51.5,-0.1"
        }
       ],
       "card": {
        "last4": "4242",
        "number": "4000000000004242"
       }
      }
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "support-read-customer"
      ],
      "masked": [
       "card.number"
      ],
      "data": {
       "id": "c-1",
       "name": "Ada Lovelace",
       "notes": "prefers email",
       "card": {
        "last4": "4242",
        "number": "[REDACTED]"
       }
      }
     }
    }
   ]
  },
  {
   "name": "the refund worker (a sub-agent) does not receive internal notes or geo data",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator",
        "refund-worker"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-1",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "id": "c-1",
       "name": "Ada Lovelace",
       "email": "ada@example.com",
       "phone": "+44 20 7946 0000",
       "region": "EU",
       "tier": "gold",
       "notes": "prefers email",
       "addresses": [
        {
         "city": "London",
         "geo": "51.5,-0.1"
        }
       ],
       "card": {
        "last4": "4242",
        "number": "4000000000004242"
       }
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "addresses[].geo",
       "card.number",
       "notes"
      ]
     }
    }
   ]
  },
  {
   "name": "a customer of another region is refused",
   "steps": [
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-2",
       "attrs": {
        "region": "US"
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "policy_forbid",
      "policies": [
       "regional-roles-stay-in-their-region"
      ]
     }
    }
   ]
  },
  {
   "name": "a request that does not state the region is refused",
   "steps": [
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-1"
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "no_matching_permit"
     }
    }
   ]
  },
  {
   "name": "rows of other regions are dropped from a list",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "anna",
       "agents": [
        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "read",
      "resource": {
       "path": "crm.ticket",
       "id": "queue",
       "attrs": {
        "region": "EU"
       }
      },
      "data": [
       {
        "id": "t-1",
        "region": "EU",
        "subject": "a"
       },
       {
        "id": "t-2",
        "region": "US",
        "subject": "b"
       }
      ]
     },
     "expect": {
      "effect": "allow",
      "rows_dropped": 1,
      "data": [
       {
        "id": "t-1",
        "region": "EU",
        "subject": "a"
       }
      ]
     }
    }
   ]
  },
  {
   "name": "a refund of 50.00 needs nobody else",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "anna",
      "agent": "support-orchestrator",
      "role": "support-agent",
      "task": "ticket-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "rf-1",
       "attrs": {
        "region": "EU"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 5000
       }
      }
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "support-refund-small"
      ]
     }
    }
   ]
  },
  {
   "name": "a refund of 50.01 waits for a supervisor",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "anna",
      "agent": "support-orchestrator",
      "role": "support-agent",
      "task": "ticket-1"
     },
     "save": {
      "t": "token"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "rf-2",
       "attrs": {
        "region": "EU"
       }
      },
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 5001
       }
      }
     },
     "expect": {
      "effect": "deny",
      "reason": "approval_required",
      "approval": {
       "label": "refund-over-50"
      }
     }
    }
   ]
  },
  {
