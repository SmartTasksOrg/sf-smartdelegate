        "support-orchestrator"
       ],
       "role": "support-agent",
       "task": "ticket-1"
      },
      "action": "update",
      "resource": {
       "path": "crm.customer",
       "id": "c-1",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "email": "new@example.com"
      },
      "strict": true
     },
     "expect": {
      "effect": "allow"
