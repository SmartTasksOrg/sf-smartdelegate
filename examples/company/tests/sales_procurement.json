  {
   "name": "lists of opportunities and contracts: rows of other regions are dropped whatever region the request states",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "petra",
       "agents": [
        "sales-orchestrator"
       ],
       "role": "sales-rep",
       "task": "deal-1"
      },
      "action": "read",
      "resource": {
       "path": "sales.opportunity",
       "id": "list",
       "attrs": {
        "region": "EU"
       }
      },
      "data": [
       {
        "id": "o-1",
        "region": "EU",
        "stage": "won"
       },
       {
        "id": "o-2",
        "region": "APAC",
        "stage": "lead"
       },
       {
        "id": "o-3",
        "region": "US",
        "stage": "lead"
       }
      ]
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "sales-read-opportunity"
      ],
      "rows_dropped": 2,
      "data": [
       {
        "id": "o-1",
        "region": "EU",
        "stage": "won"
       }
      ],
      "obligations": {
       "row_filter": [
        {
         "column": "region",
         "op": "eq",
         "value": "EU"
        }
       ]
      }
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "petra",
       "agents": [
        "sales-orchestrator"
       ],
       "role": "sales-rep",
       "task": "deal-1"
      },
      "action": "read",
      "resource": {
       "path": "sales.contract",
       "id": "list",
       "attrs": {
        "region": "EU"
       }
      },
      "data": [
       {
        "id": "k-1",
        "region": "US",
        "status": "draft"
       },
       {
        "id": "k-2",
        "region": "EU",
        "status": "signed"
       }
      ]
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "sales-read-contract"
      ],
      "rows_dropped": 1,
      "data": [
       {
        "id": "k-2",
        "region": "EU",
        "status": "signed"
       }
      ],
      "obligations": {
       "row_filter": [
        {
         "column": "region",
         "op": "eq",
         "value": "EU"
        }
       ]
      }
     }
    },
    {
     "op": "authorize",
     "input": {
      "chain": {
       "user": "petra",
       "agents": [
        "sales-orchestrator"
       ],
       "role": "sales-rep",
       "task": "deal-1"
      },
      "action": "update",
      "resource": {
       "path": "sales.opportunity",
       "id": "o-1",
       "attrs": {
        "region": "EU"
       }
      }
     },
     "expect": {
      "effect": "allow",
      "policies": [
       "sales-write-opportunity"
      ]
     }
    }
   ]
  }
 ]
