{
 "about": "Sales and procurement: pricing fields, the third level, purchase orders, vendors.",
 "cases": [
  {
   "name": "the sales orchestrator sees prices but not the margin; a sales manager sees the margin too",
   "steps": [
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "petra",
       "agents": [
        "sales-orchestrator"
       ],
       "role": "sales-rep",
       "task": "contract-1"
      },
      "action": "read",
      "resource": {
       "path": "sales.contract",
       "id": "k-1",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "id": "k-1",
       "customer_id": "c-1",
       "region": "EU",
       "status": "draft",
       "term_months": 24,
       "signatory": "A. Lovelace",
       "clauses": [
        {
         "title": "Liability",
         "text": "capped at fees paid"
        }
       ],
       "pricing": {
        "list_price": 12000000,
        "discount_pct": 15,
        "margin_pct": 38
       }
      }
     },
     "expect": {
      "effect": "allow",
      "masked": [
       "pricing.margin_pct"
      ]
     }
    },
    {
     "op": "filter",
     "input": {
      "chain": {
       "user": "sofia",
       "agents": [
        "sales-orchestrator"
       ],
       "role": "sales-manager",
       "task": "deal-1"
      },
      "action": "read",
      "resource": {
       "path": "sales.contract",
       "id": "k-1",
       "attrs": {
        "region": "EU"
       }
      },
      "data": {
       "id": "k-1",
       "customer_id": "c-1",
       "region": "EU",
       "status": "draft",
       "term_months": 24,
       "signatory": "A. Lovelace",
       "clauses": [
        {
         "title": "Liability",
         "text": "capped at fees paid"
        }
       ],
       "pricing": {
        "list_price": 12000000,
        "discount_pct": 15,
        "margin_pct": 38
       }
      }
     },
     "expect": {
      "effect": "allow",
      "masked": []
     }
    }
   ]
  },
