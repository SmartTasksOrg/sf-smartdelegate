{
 "suite": "02_delegation",
 "cases": [
  {
   "name": "sub-agent gets a narrower token and the chain is recorded",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "alice",
      "agent": "support-bot",
      "cap": {
       "actions": [
        "read",
        "create",
        "update"
       ],
       "resources": [
        "crm.customer/*",
        "billing.refund/*"
       ],
       "budget": {
        "EUR": 20000
       }
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true
     },
     "save": {
      "t": "token",
      "t_id": "token_id"
     }
    },
    {
     "op": "exchange_token",
     "input": {
      "subject_token": "$t",
      "actor": "refund-helper",
      "now": 1700000000,
      "ttl": 300,
      "cap": {
       "actions": [
        "read"
       ],
       "resources": [
        "crm.customer/c-1"
       ],
       "deny_labels": [
        "pii"
       ]
      }
     },
     "expect": {
      "ok": true,
      "user": "alice",
      "chain": [
       "support-bot",
       "refund-helper"
      ]
     },
     "save": {
      "c": "token",
      "c_id": "token_id"
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$c",
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-1"
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true,
      "effect": "allow",
      "principal": {
       "user": "alice",
       "agent": "refund-helper",
       "chain": [
        "support-bot",
        "refund-helper"
       ]
      },
      "obligations": {
       "fields": {
        "allow": [
         "card.last4",
         "id",
         "region",
         "tier"
        ]
       }
      }
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$c",
      "action": "read",
      "resource": {
       "path": "crm.customer",
       "id": "c-2"
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true,
      "effect": "deny",
      "reason": "capability_resource"
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$c",
      "action": "update",
      "resource": {
       "path": "crm.customer",
       "id": "c-1"
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true,
      "effect": "deny",
      "reason": "capability_action"
     }
    }
   ]
  },
