{
 "suite": "04_spend_limits_approval",
 "cases": [
  {
   "name": "a small refund is allowed and counted",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "alice",
      "agent": "support-bot",
      "cap": {
       "actions": [
        "read",
        "create",
        "update"
       ],
       "resources": [
        "crm.customer/*",
        "billing.refund/*"
       ],
       "budget": {
        "EUR": 20000
       }
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true
     },
     "save": {
      "t": "token",
      "t_id": "token_id"
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "r-1"
      },
      "now": 1700000000,
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 5000
       }
      }
     },
     "expect": {
      "ok": true,
      "effect": "allow",
      "policies": [
       "refund-small"
      ],
      "obligations": {
       "rate_limit": {
        "limit": 3,
        "window_seconds": 60,
        "used": 0
       }
      }
     }
    }
   ]
  },
