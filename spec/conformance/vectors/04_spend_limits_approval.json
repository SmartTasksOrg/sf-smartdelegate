  {
   "name": "a large refund waits for a human, and the approval is single use",
   "steps": [
    {
     "op": "issue_token",
     "input": {
      "user": "alice",
      "agent": "support-bot",
      "cap": {
       "actions": [
        "read",
        "create",
        "update"
       ],
       "resources": [
        "crm.customer/*",
        "billing.refund/*"
       ],
       "budget": {
        "EUR": 90000
       }
      },
      "now": 1700000000
     },
     "expect": {
      "ok": true
     },
     "save": {
      "t": "token",
      "t_id": "token_id"
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "r-1"
      },
      "now": 1700000000,
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 15000
       }
      }
     },
     "expect": {
      "ok": true,
      "effect": "deny",
      "reason": "approval_required",
      "approval": {
       "label": "refund-over-100-eur"
      }
     },
     "save": {
      "aid": "approval.id"
     }
    },
    {
     "op": "approve",
     "input": {
      "approval_id": "$aid",
      "by": "alice",
      "now": 1700000000
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "self_approval"
      }
     }
    },
    {
     "op": "approve",
     "input": {
      "approval_id": "$aid",
      "by": "carol",
      "now": 1700000000
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "approval_denied"
      }
     }
    },
    {
     "op": "approve",
     "input": {
      "approval_id": "not-a-real-id",
      "by": "bob",
      "now": 1700000000
     },
     "expect": {
      "ok": false,
      "error": {
       "code": "unknown_approval"
      }
     }
    },
    {
     "op": "approve",
     "input": {
      "approval_id": "$aid",
      "by": "bob",
      "now": 1700000000
     },
     "expect": {
      "ok": true,
      "by": "bob"
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "r-1"
      },
      "now": 1700000005,
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 15000
       }
      }
     },
     "expect": {
      "ok": true,
      "effect": "allow",
      "policies": [
       "refund-large-needs-approval"
      ],
      "obligations": {
       "approved": {
        "by": "bob"
       }
      }
     }
    },
    {
     "op": "authorize",
     "input": {
      "token": "$t",
      "action": "create",
      "resource": {
       "path": "billing.refund",
       "id": "r-1"
      },
      "now": 1700000006,
      "context": {
       "spend": {
        "currency": "EUR",
        "amount": 15000
       }
      }
     },
     "expect": {
      "ok": true,
      "effect": "deny",
      "reason": "approval_required"
     }
    }
   ]
  },
